[user]
    name = Aroon Kumar
    email = YOUR_EMAIL@example.com

[init]
    defaultBranch = main

[core]
    editor = nano
    # macOS / Linux: input
    # Windows: true (or input if using a modern editor with LF line endings)
    autocrlf = input

[pull]
    ff = only

[push]
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate
