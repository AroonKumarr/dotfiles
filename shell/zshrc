# Powerlevel10k instant prompt. Keep this near the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
export ZSH="$HOME/.oh-my-zsh"

# Personal executable scripts.
export PATH="$HOME/.local/bin:$DOTFILES/bin:$PATH"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -P "%F{yellow}Oh My Zsh is missing. Run: ~/.dotfiles/install.sh%f"
fi

[[ -f "$DOTFILES/shell/aliases.zsh" ]] && source "$DOTFILES/shell/aliases.zsh"
[[ -f "$DOTFILES/shell/functions.zsh" ]] && source "$DOTFILES/shell/functions.zsh"

case "$(uname -s)" in
  Darwin)
    [[ -f "$DOTFILES/os/macos.zsh" ]] && source "$DOTFILES/os/macos.zsh"
    ;;
  Linux)
    [[ -f "$DOTFILES/os/linux.zsh" ]] && source "$DOTFILES/os/linux.zsh"
    ;;
  MINGW*|MSYS*|CYGWIN*)
    [[ -f "$DOTFILES/os/windows.zsh" ]] && source "$DOTFILES/os/windows.zsh"
    ;;
esac

[[ -f "$DOTFILES/shell/p10k.zsh" ]] && source "$DOTFILES/shell/p10k.zsh"
